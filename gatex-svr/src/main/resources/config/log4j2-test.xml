<?xml version="1.0" encoding="UTF-8"?>
<!-- Log4j 2.x 配置文件。每5秒自动检查配置文件是否更新； -->
<Configuration monitorInterval="5" strict="true"
               xmlns="https://logging.apache.org/xml/ns"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="
                   https://logging.apache.org/xml/ns
                   https://logging.apache.org/xml/ns/log4j-config-2.xsd">
    <Appenders>
        <!-- 输出到控制台 -->
        <Console name="console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss.SSS}[%5p]%m---%l%n"/>
        </Console>

        <!-- 输出debug/info/warn/error到文件，每3小时或者超过5MB滚动一次 -->
        <RollingFile name="logfile" fileName="log/current.log"
                     filePattern="log/$${date:yyyyMMdd}/%d{yyyyMMddHH}-%i.log.gz">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS}[%5p]%m---%l %t%n"/>
            <!-- 滚动策略: 超过30个归档就会将旧的删除，以释放磁盘空间 -->
            <DefaultRolloverStrategy max="30"/>
            <Policies>
                <!-- 当应用程序启动时，如果目标日志文件（如 current.log）已经存在，则会立即触发一次日志文件的滚动操作-->
                <!-- 防止多个实例或重启后的应用写入同一个日志文件 -->
                <OnStartupTriggeringPolicy/>
                <!-- 每3小时滚动一次日志文件-->
                <TimeBasedTriggeringPolicy interval="3"/>
                <!-- 按大小分割日志文件 -->
                <SizeBasedTriggeringPolicy size="5 MB"/>
            </Policies>
        </RollingFile>

        <!-- 只输出warn/error到文件，每3小时或者超过5MB滚动一次 -->
        <RollingFile name="errfile" fileName="log/current.error"
                     filePattern="log/$${date:yyyyMMdd}/%d{yyyyMMddHH}-%i.error.gz">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS}[%5p]%m---%l %t%n"/>
            <!-- 滚动策略: 超过30个归档就会将旧的删除，以释放磁盘空间 -->
            <DefaultRolloverStrategy max="30"/>
            <Policies>
                <!-- 当应用程序启动时，如果目标日志文件（如 current.log）已经存在，则会立即触发一次日志文件的滚动操作-->
                <!-- 防止多个实例或重启后的应用写入同一个日志文件 -->
                <OnStartupTriggeringPolicy/>
                <!-- 每3小时滚动一次日志文件-->
                <TimeBasedTriggeringPolicy interval="3"/>
                <!-- 按大小分割日志文件 -->
                <SizeBasedTriggeringPolicy size="5 MB"/>
            </Policies>
        </RollingFile>
    </Appenders>
    <Loggers>
        <!-- 全局配置(配置 includeLocation 为 false，避免每次打印日志需要获取调用堆栈的性能损耗) -->
        <Root level="DEBUG">
            <AppenderRef ref="console"/>
            <AppenderRef ref="logfile"/>
            <AppenderRef ref="errfile"/>
        </Root>
        <Logger name="rebue" level="TRACE"/>
        <Logger name="org.apache.kafka" level="WARN"/>
        <Logger name="io.netty.handler.logging.LoggingHandler" level="INFO"/>
    </Loggers>

</Configuration>